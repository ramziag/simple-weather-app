<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <io.github.ramziag.weather.RadarView
        android:id="@+id/radar_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/radar_map" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/radar_zoom_in"
            style="@style/MapButton"
            android:contentDescription="@string/zoom_in"
            android:src="@drawable/ic_add" />

        <ImageButton
            android:id="@+id/radar_zoom_out"
            style="@style/MapButton"
            android:contentDescription="@string/zoom_out"
            android:src="@drawable/ic_minus" />

        <ImageButton
            android:id="@+id/radar_locate"
            style="@style/MapButton"
            android:contentDescription="@string/recenter"
            android:src="@drawable/ic_locate" />
    </LinearLayout>

    <TextView
        android:id="@+id/radar_status"
        style="@style/Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_card"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/radar_play"
                style="@style/HeaderButton"
                android:contentDescription="@string/play"
                android:src="@drawable/ic_play" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/radar_time"
                    style="@style/Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="6dp" />

                <SeekBar
                    android:id="@+id/radar_seek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:progressBackgroundTint="?attr/wLine"
                    android:progressTint="?attr/wText"
                    android:thumbTint="?attr/wText" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Text.Sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:text="@string/radar_credit"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
