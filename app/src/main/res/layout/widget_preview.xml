<?xml version="1.0" encoding="utf-8"?>
<!-- Widget layout: drawn by the launcher, so only RemoteViews-safe views and no app theme attributes. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:tint="@color/widget_preview_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/widget_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/widget_text"
                android:textSize="14sp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:text="Springfield" />

            <TextView
                android:id="@+id/updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/widget_sub"
                android:textSize="11sp"
                android:layout_marginStart="8dp"
                android:text="12:40 PM" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no"
                android:tint="@color/widget_text"
                android:src="@drawable/widget_partly_day" />

            <TextView
                android:id="@+id/temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/widget_text"
                android:textSize="40sp"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-light"
                android:text="67°" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_text"
                    android:textSize="14sp"
                    android:ellipsize="end"
                    android:text="Partly cloudy" />

                <TextView
                    android:id="@+id/hilo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_sub"
                    android:textSize="12sp"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:text="H 68°  L 46°" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/h0_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_sub"
                    android:textSize="11sp"
                    android:text="Now" />

                <ImageView
                    android:id="@+id/h0_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:importantForAccessibility="no"
                    android:tint="@color/widget_text"
                    android:src="@drawable/widget_partly_day" />

                <TextView
                    android:id="@+id/h0_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_text"
                    android:textSize="13sp"
                    android:text="67°" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/h1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_sub"
                    android:textSize="11sp"
                    android:text="1 PM" />

                <ImageView
                    android:id="@+id/h1_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:importantForAccessibility="no"
                    android:tint="@color/widget_text"
                    android:src="@drawable/widget_clear_day" />

                <TextView
                    android:id="@+id/h1_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_text"
                    android:textSize="13sp"
                    android:text="68°" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/h2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_sub"
                    android:textSize="11sp"
                    android:text="2 PM" />

                <ImageView
                    android:id="@+id/h2_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:importantForAccessibility="no"
                    android:tint="@color/widget_text"
                    android:src="@drawable/widget_clear_day" />

                <TextView
                    android:id="@+id/h2_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_text"
                    android:textSize="13sp"
                    android:text="68°" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/h3_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_sub"
                    android:textSize="11sp"
                    android:text="3 PM" />

                <ImageView
                    android:id="@+id/h3_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:importantForAccessibility="no"
                    android:tint="@color/widget_text"
                    android:src="@drawable/widget_partly_day" />

                <TextView
                    android:id="@+id/h3_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_text"
                    android:textSize="13sp"
                    android:text="67°" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/h4_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_sub"
                    android:textSize="11sp"
                    android:text="4 PM" />

                <ImageView
                    android:id="@+id/h4_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:importantForAccessibility="no"
                    android:tint="@color/widget_text"
                    android:src="@drawable/widget_cloudy" />

                <TextView
                    android:id="@+id/h4_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_text"
                    android:textSize="13sp"
                    android:text="65°" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/h5_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_sub"
                    android:textSize="11sp"
                    android:text="5 PM" />

                <ImageView
                    android:id="@+id/h5_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:importantForAccessibility="no"
                    android:tint="@color/widget_text"
                    android:src="@drawable/widget_cloudy" />

                <TextView
                    android:id="@+id/h5_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_text"
                    android:textSize="13sp"
                    android:text="63°" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/d0_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_text"
                    android:textSize="13sp"
                    android:minWidth="36dp"
                    android:text="Sun" />

                <ImageView
                    android:id="@+id/d0_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no"
                    android:tint="@color/widget_text"
                    android:src="@drawable/widget_clear_day" />

                <TextView
                    android:id="@+id/d0_pop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_sub"
                    android:textSize="12sp"
                    android:text="" />

                <TextView
                    android:id="@+id/d0_temps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_text"
                    android:textSize="13sp"
                    android:layout_marginStart="10dp"
                    android:text="46° / 68°" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/d1_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_text"
                    android:textSize="13sp"
                    android:minWidth="36dp"
                    android:text="Mon" />

                <ImageView
                    android:id="@+id/d1_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no"
                    android:tint="@color/widget_text"
                    android:src="@drawable/widget_partly_day" />

                <TextView
                    android:id="@+id/d1_pop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_sub"
                    android:textSize="12sp"
                    android:text="20%" />

                <TextView
                    android:id="@+id/d1_temps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_text"
                    android:textSize="13sp"
                    android:layout_marginStart="10dp"
                    android:text="46° / 67°" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/d2_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_text"
                    android:textSize="13sp"
                    android:minWidth="36dp"
                    android:text="Tue" />

                <ImageView
                    android:id="@+id/d2_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no"
                    android:tint="@color/widget_text"
                    android:src="@drawable/widget_cloudy" />

                <TextView
                    android:id="@+id/d2_pop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_sub"
                    android:textSize="12sp"
                    android:text="35%" />

                <TextView
                    android:id="@+id/d2_temps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_text"
                    android:textSize="13sp"
                    android:layout_marginStart="10dp"
                    android:text="46° / 67°" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/d3_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_text"
                    android:textSize="13sp"
                    android:minWidth="36dp"
                    android:text="Wed" />

                <ImageView
                    android:id="@+id/d3_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no"
                    android:tint="@color/widget_text"
                    android:src="@drawable/widget_rain" />

                <TextView
                    android:id="@+id/d3_pop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_sub"
                    android:textSize="12sp"
                    android:text="80%" />

                <TextView
                    android:id="@+id/d3_temps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_text"
                    android:textSize="13sp"
                    android:layout_marginStart="10dp"
                    android:text="45° / 67°" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
